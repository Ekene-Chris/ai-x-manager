# Database
DATABASE_URL=sqlite:///./ai_x_manager.db
# For PostgreSQL: postgresql://user:password@localhost/ai_x_manager

# X (Twitter) API - OAuth 2.0 (RECOMMENDED)
# Get these from https://developer.twitter.com/en/portal/projects-and-apps
# Create an app and get OAuth 2.0 Client ID and Client Secret
TWITTER_CLIENT_ID=your_client_id
TWITTER_CLIENT_SECRET=your_client_secret
# For local: http://localhost:8000/api/auth/twitter/callback
# For production: https://your-app.azurecontainerapps.io/api/auth/twitter/callback
TWITTER_REDIRECT_URI=http://localhost:8000/api/auth/twitter/callback

# X (Twitter) API - Legacy Authentication (OPTIONAL)
# Only needed if you want to use direct API keys instead of OAuth
# TWITTER_API_KEY=your_api_key
# TWITTER_API_SECRET=your_api_secret
# TWITTER_ACCESS_TOKEN=your_access_token
# TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret
# TWITTER_BEARER_TOKEN=your_bearer_token

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Application Settings
SECRET_KEY=your-secret-key-change-this
ENVIRONMENT=development
LOG_LEVEL=INFO

# Dashboard Authentication (REQUIRED for production)
# Set these to protect your dashboard with HTTP Basic Auth
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-strong-password

# Scheduler
SCHEDULER_TIMEZONE=UTC
